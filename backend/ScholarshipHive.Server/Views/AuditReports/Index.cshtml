@model List<AuditReport>
@{
    ViewData["Title"] = "Audit Reports";
    ViewData["ActiveTab"] = "Audit";
    string Initials(string s) => string.Concat(s.Split(' ').Where(w => w.Length > 0).Select(w => w[0])).ToUpper();
}

<div class="page-header">
    <div>
        <h2>Reports</h2>
        <p>Compiled findings uploaded by Auditors, covering everyone's work and data.</p>
    </div>
</div>

<partial name="_ReportsTabStrip" />

<div class="card">
    @foreach (var r in Model)
    {
        <a asp-action="Details" asp-route-id="@r.Id" class="list-row" style="text-decoration:none;color:inherit">
            <span class="av">@Initials(r.AuditorUser?.Username ?? "?")</span>
            <div class="grow"><p class="nm">@r.Title</p><p class="rl">by @r.AuditorUser?.Username · @r.CreatedAt.ToPakistanTime().ToString("yyyy-MM-dd hh:mm tt")</p></div>
            @if (r.Files.Any())
            {
                <span class="tag" style="background:var(--accSoft);color:var(--accDeep)">@r.Files.Count file@(r.Files.Count == 1 ? "" : "s")</span>
            }
            <span class="link">View →</span>
        </a>
    }
    @if (!Model.Any())
    {
        <p class="text-center text-muted py-4 mb-0">No audit reports uploaded yet.</p>
    }
</div>

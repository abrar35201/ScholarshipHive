@model List<ScholarshipHive.Server.Models.CallingFormEntry>
@{ ViewData["Title"] = "Calling Team Forms"; }
<div class="page-header"><div><h2>Calling team saved forms</h2><p>Submitted drafts from your Calling employees. These do not count as signed consent.</p></div></div>
<div class="sh-card p-3 table-responsive"><table class="table"><thead><tr><th>Applicant</th><th>Employee</th><th>Form</th><th>Saved (UTC)</th><th>Share</th></tr></thead><tbody>
@foreach(var e in Model){<tr><td><a href="/CallingHeadForms/Details/@e.Id">@e.ApplicantName</a></td><td>@e.CreatedByUser.FullName</td><td>@e.TemplateId</td><td>@e.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td><td>@(e.PublicShareTokenHash == null ? "Not shared" : "Link active")</td></tr>}
</tbody></table>@if(Model.Count==0){<p>No saved Calling drafts yet.</p>}</div>

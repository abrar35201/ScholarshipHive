@using ScholarshipHive.Server.Models
@using ScholarshipHive.Server.Services
@model CallingFormEntry
@{Layout=null;var template=(CallingFormTemplate?)ViewBag.Template;var answers=(Dictionary<string,string>)ViewBag.Answers;}
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow,noarchive"/><title>Shared application draft</title>
<style>body{font-family:system-ui,Arial,sans-serif;background:#f3f8fa;color:#142c35;margin:0;padding:24px}main{max-width:780px;margin:auto;background:white;padding:28px;border:1px solid #ddd;border-radius:14px}h1{font-size:25px}dt{font-weight:700;color:#235668;margin-top:12px}dd{margin:3px 0 12px;overflow-wrap:anywhere}small{color:#52616b}</style></head><body><main>
<h1>Application details — @Model.ApplicantName</h1><p>@(template?.Name ?? Model.TemplateId)</p><small>Shared draft. This document is not a signed consent form or an original PDF agreement.</small>
<dl><dt>Applicant name</dt><dd>@Model.ApplicantName</dd><dt>Phone</dt><dd>@Model.Phone</dd><dt>Email</dt><dd>@Model.Email</dd>
@foreach(var field in answers){<dt>@field.Key</dt><dd>@field.Value</dd>}</dl>
<p><small>Contact the Calling team to verify details against the original consent agreement.</small></p>
</main></body></html>

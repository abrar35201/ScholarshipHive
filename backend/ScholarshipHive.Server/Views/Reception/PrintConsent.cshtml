@model ScholarshipHive.Server.Models.ReceptionConsent
@{ Layout = null; ViewData["Title"] = "Italy Consent"; }
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Italy Consent - @Model.ClientFullName</title>
<style>body{font-family:Arial,sans-serif;max-width:820px;margin:35px auto;color:#163043;padding:20px}h1{color:#0b829a}h2{font-size:18px}section{border:1px solid #d8e5e9;border-radius:12px;padding:20px;margin:20px 0}dl{display:grid;grid-template-columns:200px 1fr;gap:12px}dt{font-weight:bold}.controls{margin:10px 0 25px}button{background:#0795ad;color:white;border:0;padding:11px 18px;border-radius:8px}@@media print{.controls{display:none}body{margin:0}}</style>
</head><body><div class="controls"><button onclick="window.print()">Print / Save as PDF</button></div>
<h1>ScholarshipHive · Italy Consent Record</h1><p>Record #@Model.Id · Created @Model.CreatedAt.ToString("yyyy-MM-dd") · @Model.Status</p>
<section><h2>Client information</h2><dl>
<dt>Full name</dt><dd>@Model.ClientFullName</dd><dt>Family</dt><dd>@Model.FamilyName</dd>
<dt>Contact</dt><dd>@Model.PhoneNumber</dd><dt>City</dt><dd>@Model.DomicileCity</dd>
<dt>CNIC</dt><dd>@Model.CnicNumber</dd><dt>Passport</dt><dd>@Model.PassportNumber</dd>
<dt>Address</dt><dd>@Model.FullAddress</dd><dt>Qualifications</dt><dd>@Model.QualificationDetails</dd>
<dt>Counselor</dt><dd>@Model.CounselorName</dd><dt>Policy</dt><dd>@Model.PolicyVariant</dd>
<dt>Total agreed package</dt><dd>@Model.TotalPackageFee</dd>
</dl></section><p><strong>Important:</strong> This record does not constitute a digitally signed consent. Review the agreement and obtain the required handwritten signature before using it as signed evidence.</p>
<section><p>Client signature: __________________________</p><p>Date: __________________</p></section></body></html>
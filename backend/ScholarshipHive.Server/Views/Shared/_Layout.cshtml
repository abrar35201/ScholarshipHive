@using Microsoft.EntityFrameworkCore
@using ScholarshipHive.Server.Data
@using ScholarshipHive.Server.Models
@inject AppDbContext Db
@{
    // Web login is Admin-only, so any authenticated session here is always an Admin.
    var isAuthed = User.Identity?.IsAuthenticated == true;
    var isReception = User.IsInRole("Receptionist");
    var isAuditor = User.IsInRole("Auditor");
    var isDepartmentHead = User.IsInRole("HeadOfCounselors") || User.IsInRole("HeadOfMarketing") || User.IsInRole("HeadOfProcessing");
    var isCountry = User.IsInRole("CountryHead");
    var homeController = isReception ? "Reception" : isDepartmentHead ? "TeamScope" : isAuditor ? "ActivityLog" : "Home";
    var activeRouterCount = isAuthed ? await Db.AllowedRouters.CountAsync(r => r.IsActive) : 0;
    // The notification bell's count — real pending work, not decorative: unapproved
    // self-registrations plus networks a device tried but nobody's approved yet.
    var pendingApprovals = isAuthed ? await Db.Users.CountAsync(u => !u.IsApproved) : 0;
    var pendingNetworksCount = isAuthed ? await Db.PendingNetworks.CountAsync() : 0;
    var pendingLeavesCount = isAuthed ? await Db.LeaveRequests.CountAsync(l => l.Status == "Pending") : 0;
    var pendingShiftsCount = isAuthed ? await Db.ShiftChangeRequests.CountAsync(x => x.Status == "Pending") : 0;
    var notificationCount = isReception || isDepartmentHead ? 0 : pendingApprovals + pendingNetworksCount + pendingLeavesCount + pendingShiftsCount;
    var meInitials = isAuthed
        ? string.Concat((User.Identity!.Name ?? "?").Split(' ', '.', '_').Where(w => w.Length > 0).Select(w => w[0])).ToUpper()
        : "";
    if (meInitials.Length > 2) meInitials = meInitials[..2];
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ScholarshipHive Admin</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Outfit:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    @if (isAuthed)
    {
        <div class="app-shell">
            <aside class="sidebar">
                <a class="brand" asp-controller="@homeController" asp-action="Index" aria-label="ScholarshipHive home" style="text-decoration:none;color:inherit">
                    <img src="~/images/logo.png" alt="ScholarshipHive" class="brand-mark" />
                    <span class="brand-name">ScholarshipHive</span>
                </a>
                <nav class="side-nav">
                    @if (!isReception && !isDepartmentHead)
                    {
                    <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v4M12 3a9 9 0 1 0 6.4 2.6"/><path d="M12 8v4l3 2"/></svg>
                        <span>Today</span>
                    </a>
                    <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Attendance" ? "active" : "")" asp-controller="Attendance" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2"/><path d="M9 2h6"/></svg>
                        <span>Attendance</span>
                    </a>
                    <a class="side-link @((ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" || ViewContext.RouteData.Values["controller"]?.ToString() == "AuditReports") ? "active" : "")" asp-controller="Reports" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h7l3 3v15H7z"/><path d="M14 3v3h3"/><path d="M9.5 12h5M9.5 15.5h5M9.5 8.5h2"/></svg>
                        <span>Reports</span>
                    </a>
                    <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 19c0-3.3 2.9-6 6.5-6s6.5 2.7 6.5 6"/><path d="M16 8.2c1.4.3 2.5 1.5 2.5 3s-1.1 2.7-2.5 3"/><path d="M18 13.3c2 .5 3.5 2.2 3.5 4.2"/></svg>
                        <span>Team</span>
                    </a>
                    <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Shifts" ? "active" : "")" asp-controller="Shifts" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
                        <span>Shifts</span>
                    </a>
                    <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Analytics" ? "active" : "")" asp-controller="Analytics" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V9M11 19V4M18 19v-7"/></svg>
                        <span>Analytics</span>
                    </a>
                    <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Hours" ? "active" : "")" asp-controller="Hours" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 6.5v6h5"/></svg>
                        <span>Hours</span>
                    </a>
                    @if (User.IsInRole("Auditor") || User.IsInRole("Admin") || User.IsInRole("Owner") || User.IsInRole("SuperAdmin"))
                    {
                        <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ActivityLog" ? "active" : "")" asp-controller="ActivityLog" asp-action="Index"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/></svg><span>Audit Activity</span></a>
                    }
                    <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leaves" ? "active" : "")" asp-controller="Leaves" asp-action="Index"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18M8 15l2 2 5-5"/></svg><span>Leave Requests</span></a>
                    <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reception" ? "active" : "")" asp-controller="Reception" asp-action="Index"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M5 21V5h14v16M9 5V3h6v2M8 9h2M14 9h2M8 13h2M14 13h2M10 21v-4h4v4"/></svg><span>Reception</span></a>
                    @if (!isCountry) {
                    <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "NetworkSettings" ? "active" : "")" asp-controller="NetworkSettings" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9c5.5-5 14.5-5 20 0"/><path d="M5.5 13c3.7-3.3 9.3-3.3 13 0"/><path d="M9 17c1.8-1.6 4.2-1.6 6 0"/><circle cx="12" cy="20" r="1"/></svg>
                        <span>Network Settings</span>
                    </a>
                    }
                    @if (!isCountry) {
                    <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Chat" ? "active" : "")" asp-controller="Chat" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.4 3.4L17 7.8l-3.6 1.4L12 12.6l-1.4-3.4L7 7.8l3.6-1.4z"/><path d="M5 15l.8 1.8L7.6 17.6l-1.8.8L5 20.2l-.8-1.8L2.4 17.6l1.8-.8z"/></svg>
                        <span>AI Assistant</span>
                    </a>
                    }
                    <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Announcements" ? "active" : "")" href="/Announcements"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10h4l10-5v14L7 14H3zM7 14l2 6h3M20 9a4 4 0 0 1 0 6"/></svg><span>Announcements</span></a>
                    <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ShiftRequests" ? "active" : "")" asp-controller="ShiftRequests" asp-action="Index"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M7 2v4M17 2v4M3 9h18M12 12v4l3 1"/></svg><span>Shift Requests</span></a>
                    }
                    @if (isReception)
                    {
                        <a class="side-link" asp-controller="Reception" asp-action="Index"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M5 21V5h14v16M9 5V3h6v2M8 9h2M14 9h2M8 13h2M14 13h2M10 21v-4h4v4"/></svg><span>Reception</span></a>
                        <a class="side-link" href="/Announcements"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10h4l10-5v14L7 14H3zM7 14l2 6h3M20 9a4 4 0 0 1 0 6"/></svg><span>Announcements</span></a>
                    }
                    @if (isDepartmentHead)
                    {
                        <a class="side-link" href="/TeamScope"><span>My Department Dashboard</span></a>
                        <a class="side-link" href="/Announcements"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10h4l10-5v14L7 14H3zM7 14l2 6h3M20 9a4 4 0 0 1 0 6"/></svg><span>Announcements</span></a>
                    }
                </nav>
                <div class="routerbox">
                    <b>Router lock is @(activeRouterCount > 0 ? "on" : "not configured")</b>
                    <p>
                        @if (activeRouterCount > 0)
                        {
                            @($"Check-ins only work on {activeRouterCount} approved network{(activeRouterCount == 1 ? "" : "s")}.")
                        }
                        else
                        {
                            @("Add a router under Network Settings to start locking check-ins to your office.")
                        }
                    </p>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar-footer">
                    <div class="current-user">Signed in as <strong>@User.Identity!.Name</strong></div>
                    <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Log out</button>
                </form>
            </aside>
            <main class="main-content">
                <header class="top">
                    <form class="search" method="get" action="@(isReception ? "/Reception" : isDepartmentHead ? "/TeamScope" : "/Users")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                        <input type="search" name="q" value="@(isDepartmentHead ? (string?)ViewBag.SearchQuery : "")" placeholder="@(isDepartmentHead ? "Search your department by name or username" : "Search a person by name or username")" />
                    </form>
                    <div class="tright">
                        <span class="mono" id="topClock" style="font-size:12.5px;color:var(--mute)"></span>
                        <a class="iconbtn" asp-controller="@(isReception || isDepartmentHead ? "Announcements" : "Notifications")" asp-action="Index" aria-label="Notifications" title="@(isReception || isDepartmentHead ? "Department announcements" : notificationCount.ToString() + " pending item(s)")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/></svg>
                            @if (notificationCount > 0)
                            {
                                <i></i>
                            }
                        </a>
                        <div class="me"><span class="av">@meInitials</span><b>@User.Identity!.Name</b></div>
                    </div>
                </header>
                <div class="view-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @RenderBody()
                </div>
            </main>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js"></script>
    @if (isAuthed)
    {
        <script>
            (function () {
                var clock = document.getElementById('topClock');
                if (!clock) return;
                function tick() { clock.textContent = new Date().toLocaleTimeString('en-GB', { hour12: false }); }
                tick();
                setInterval(tick, 1000);
            })();
        </script>
        <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
        <script>
            // Live updates: the moment attendance/users/reports/network data changes
            // anywhere (mobile app, another admin session, etc.), re-fetch this same page
            // in the background and swap in just the data — no full reload, no flash, and
            // any filters/scroll position stay put. Skipped while the admin is actively
            // typing in a field, so an in-progress form isn't wiped out from under them;
            // the next event will catch it.
            (function () {
                var connection = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/attendance")
                    .withAutomaticReconnect()
                    .build();

                var refreshing = false;
                async function refreshLiveRegion() {
                    var region = document.getElementById("live-region");
                    if (!region || refreshing || document.hidden) return;

                    var active = document.activeElement;
                    var isTyping = active && (active.tagName === "INPUT" || active.tagName === "TEXTAREA" || active.tagName === "SELECT");
                    if (isTyping) return;

                    refreshing = true;
                    try {
                        // Don't reuse a cached copy of the dashboard. Preserve period filter.
                        var res = await fetch(window.location.href, {cache: "no-store", credentials: "same-origin"});
                        if (!res.ok || !res.headers.get("content-type")?.includes("text/html")) {
                            var st = document.getElementById("dashboard-update-status");
                            if (st) st.textContent = "Refresh unavailable (" + res.status + ")";
                            return;
                        }
                        var html = await res.text();
                        var doc = new DOMParser().parseFromString(html, "text/html");
                        var newRegion = doc.getElementById("live-region");
                        if (newRegion) {
                            region.innerHTML = newRegion.innerHTML;
                            // The heading and its live count also come from the same database response.
                            var freshHeading = doc.querySelector(".page-header p");
                            var currentHeading = document.querySelector(".page-header p");
                            if (freshHeading && currentHeading) currentHeading.textContent = freshHeading.textContent;
                            var refreshedAt = document.getElementById("dashboard-update-status");
                            if (refreshedAt) refreshedAt.textContent = "Updated " + new Date().toLocaleTimeString();
                        }
                    } catch (err) {
                        console.error("Live refresh failed:", err);
                    } finally {
                        refreshing = false;
                    }
                }

                window.refreshDashboard = refreshLiveRegion;
                connection.on("DataChanged", refreshLiveRegion);
                connection.start().catch(function (err) {
                    console.warn("Realtime connection unavailable; polling remains enabled:", err);
                });
                // Guarantees fresh figures even if the real-time event is missed.
                setInterval(refreshLiveRegion, 20000);
                document.addEventListener("visibilitychange", function () {
                    if (!document.hidden) refreshLiveRegion();
                });
            })();
        </script>
    }
    @if (isAuthed)
    {
        <script>
          // Login notices remain in Announcements history; acknowledgement is per browser.
          document.addEventListener('DOMContentLoaded', async function () {
            try {
              const response=await fetch('/Announcements/Feed',{credentials:'same-origin',cache:'no-store'});
              if(!response.ok) return;
              const announcements=await response.json();
              const username=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(User.Identity!.Name ?? ""));
              const storageKey='scholarshiphive_web_notices_v2_'+username.toLowerCase();
              const seen=new Set(JSON.parse(localStorage.getItem(storageKey)||'[]'));
              const pending=announcements.filter(x=>!seen.has(String(x.id)+':'+x.updatedAt));
              if(pending.length===0) return;
              const modal=document.createElement('div');modal.className='modal fade';modal.tabIndex=-1;
              modal.innerHTML='<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Important announcements</h5></div><div class="modal-body"></div><div class="modal-footer"><button type="button" class="btn btn-primary" id="ackNotices">I have read these</button></div></div></div>';
              const body=modal.querySelector('.modal-body');
              for(const a of pending){
                const item=document.createElement('div');item.className='border-bottom mb-3 pb-2';
                const title=document.createElement('strong');title.textContent=a.title;
                const msg=document.createElement('p');msg.className='mb-1';msg.textContent=a.body;
                const sender=document.createElement('small');sender.textContent=`${a.author} (${a.authorRole || 'Unknown role'})`;
                item.append(title,msg,sender);body.appendChild(item);
              }
              document.body.appendChild(modal);
              const instance=new bootstrap.Modal(modal,{backdrop:'static',keyboard:false});
              modal.querySelector('#ackNotices').addEventListener('click',()=>{
                for(const a of pending) seen.add(String(a.id)+':'+a.updatedAt);
                localStorage.setItem(storageKey,JSON.stringify([...seen]));instance.hide();
              });
              modal.addEventListener('hidden.bs.modal',()=>modal.remove(),{once:true});instance.show();
            }catch(err){console.warn('Announcement popup unavailable',err);}
          });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

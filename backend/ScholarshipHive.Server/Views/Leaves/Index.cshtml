@model List<ScholarshipHive.Server.Models.LeaveRequest>
@{ ViewData["Title"] = "Leave Requests"; }
<div class="page-header"><div><h2>Leave Requests</h2><p>Review employee applications submitted from anywhere.</p></div></div>
<div class="sh-card p-3">
<table class="table table-hover"><thead><tr><th>Employee</th><th>Date</th><th>Type</th><th>Reason</th><th>Status</th><th>Action</th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td>@item.User?.FullName (@item.User?.Username)</td><td>@item.LeaveDate</td><td>@item.LeaveType</td><td>@item.Reason</td><td>@item.Status</td><td>
@if (item.Status == "Pending") {
<form asp-action="Decide" method="post" class="d-inline"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="decision" value="Approved"/><button class="btn btn-sm btn-success">Approve</button></form>
<form asp-action="Decide" method="post" class="d-inline"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="decision" value="Rejected"/><button class="btn btn-sm btn-outline-danger">Reject</button></form>
}</td></tr>
}</tbody></table>
@if (Model.Count == 0) { <p class="text-muted">No leave requests yet.</p> }
</div>

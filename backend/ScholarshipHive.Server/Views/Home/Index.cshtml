@using ScholarshipHive.Server.Services
@model DashboardViewModel
@{
    ViewData["Title"] = "Today";
    var todayLabel = DateTimeExtensions.PakistanToday().ToString("dddd, d MMMM");
}

<div class="page-header">
    <div>
        <h2>Today</h2>
        <p>@todayLabel · @Model.CheckedInNow people on the floor</p>
    </div>
    <div class="seg">
        <a class="@(Model.Period == "day" ? "on" : "")" asp-action="Index" asp-route-period="day">Day</a>
        <a class="@(Model.Period == "week" ? "on" : "")" asp-action="Index" asp-route-period="week">Week</a>
        <a class="@(Model.Period == "month" ? "on" : "")" asp-action="Index" asp-route-period="month">Month</a>
    </div>
</div>

@if (!Model.PushNotificationsEnabled)
{
    <div class="alert alert-warning py-2 mb-3">
        Push notifications (FCM) are disabled — likely a missing/invalid <code>Firebase:ServiceAccountJson</code> config value.
        Background auto check-in can't self-recover from a missed geofence event or an OEM-killed background process
        without this; employees may need to open the app manually to check in until it's fixed.
    </div>
}

<div class="text-end mb-2" style="font-size:11px;color:var(--mute)" id="dashboard-refreshed-at" aria-live="polite"><span id="dashboard-update-status">Live data · auto refresh every 20s</span> <button class="btn btn-sm btn-outline-secondary ms-2" type="button" onclick="window.refreshDashboard?.()">Refresh now</button></div>
<div id="live-region">
    <div class="stat-grid">
        <a class="stat-card stat up" style="text-decoration:none;color:inherit;cursor:pointer;display:block" asp-controller="Attendance" asp-action="Index">
            <p class="l">On the floor</p>
            <p class="v">@Model.CheckedInNow</p>
            <p class="x">of @Model.TotalActiveEmployees · @Model.AwayCount away</p>
        </a>
        <a class="stat-card stat up" style="text-decoration:none;color:inherit;cursor:pointer;display:block" asp-controller="Attendance" asp-action="Index">
            <div style="display:flex;align-items:center;justify-content:space-between">
                <p class="l">Average arrival</p>
                @if (Model.AverageArrivalTrendMinutes != 0)
                {
                    var improved = Model.AverageArrivalTrendMinutes <= 0;
                    <span class="delta" style="background:@(improved ? "var(--okSoft)" : "var(--badSoft)");color:@(improved ? "var(--ok)" : "var(--bad)")">@(Model.AverageArrivalTrendMinutes > 0 ? "+" : "")@Model.AverageArrivalTrendMinutes m</span>
                }
            </div>
            <p class="v">@Model.AverageArrivalLabel</p>
            <p class="x">@Model.AverageArrivalSublabel</p>
        </a>
        <a class="stat-card stat up" style="text-decoration:none;color:inherit;cursor:pointer;display:block" asp-controller="Reports" asp-action="Index">
            <div style="display:flex;align-items:center;justify-content:space-between">
                <p class="l">Reports filed</p>
                @if (Model.ReportsFiledTrendPct != 0)
                {
                    var up = Model.ReportsFiledTrendPct > 0;
                    <span class="delta" style="background:@(up ? "var(--okSoft)" : "var(--badSoft)");color:@(up ? "var(--ok)" : "var(--bad)")">@(up ? "+" : "")@Model.ReportsFiledTrendPct%</span>
                }
            </div>
            <p class="v">@Model.ReportsFiledRate%</p>
            <p class="x">@Model.ReportsFiledFraction shifts</p>
        </a>
        <a class="stat-card stat up" style="text-decoration:none;color:inherit;cursor:pointer;display:block" asp-controller="Attendance" asp-action="Index">
            <div style="display:flex;align-items:center;justify-content:space-between">
                <p class="l">Punctuality rate</p>
                @if (Model.PunctualityRateTrendPct != 0)
                {
                    var up = Model.PunctualityRateTrendPct > 0;
                    <span class="delta" style="background:@(up ? "var(--okSoft)" : "var(--badSoft)");color:@(up ? "var(--ok)" : "var(--bad)")">@(up ? "+" : "")@Model.PunctualityRateTrendPct%</span>
                }
            </div>
            <p class="v">@Model.PunctualityRatePct%</p>
            <p class="x">on-time this @Model.Period · Day/Night shifts</p>
        </a>
    </div>

    @if (Model.ShiftHealth.Any())
    {
        <div class="card mb-3">
            <div class="sect"><div><h3>Shift-wise attendance</h3><p>Last 30 days · Day/Night shifts only</p></div></div>
            @foreach (var s in Model.ShiftHealth)
            {
                <div class="list-row">
                    <div class="grow">
                        <p class="nm">@s.ShiftLabel shift</p>
                        <p class="rl">@s.PresentToday of @s.ActiveEmployees on the floor today · @s.PunctualityRatePct30d% punctual</p>
                    </div>
                    <span class="tag" style="background:var(--okSoft);color:var(--ok)">@s.AttendanceRatePct30d% attendance</span>
                </div>
            }
        </div>
    }

    <div class="grid g2">
        <div class="card up">
            <div class="sect">
                <div><h3>Headcount this week</h3><p>People with an attendance record each day</p></div>
                <span class="mono" style="margin-left:auto;font-size:11.5px;color:var(--mute)">
                    avg @(Model.WeeklyHeadcount.Count > 0 ? Math.Round(Model.WeeklyHeadcount.Average(x => x.Value), 1) : 0)
                </span>
            </div>
            <div class="pad">@Html.Raw(ChartSvg.Bars(Model.WeeklyHeadcount, 340, 150))</div>
        </div>
        <div class="card up">
            <div class="sect"><div><h3>Check-ins through the day</h3><p>New check-ins per hour, 7 AM &ndash; 7 AM (covers Night/Internship shifts too)</p></div></div>
            <div class="pad" style="overflow-x:auto">@Html.Raw(ChartSvg.Area(Model.ArrivalCurve, Math.Max(520, Model.ArrivalCurve.Count * 26), 150, fixedWidth: false))</div>
        </div>
    </div>

    <div class="card mt">
        <div class="sect">
            <div><h3>Live roster</h3><p>Updated every 30 seconds</p></div>
            <a class="link" asp-controller="Users" asp-action="Index">See everyone</a>
        </div>
        @foreach (var r in Model.Roster)
        {
            var (bg, fg, label) = r.Status switch
            {
                "OnFloor" => ("var(--okSoft)", "var(--ok)", "On floor"),
                "CheckedOut" => ("var(--accSoft)", "var(--accDeep)", "Checked out"),
                "Late" => ("var(--warnSoft)", "var(--warn)", "Late"),
                _ => ("var(--badSoft)", "var(--bad)", "Absent"),
            };
            <a class="list-row" style="text-decoration:none;color:inherit;cursor:pointer" asp-controller="Users" asp-action="Details" asp-route-id="@r.UserId">
                <span class="av">@(string.Concat(r.Name.Split(' ').Where(w => w.Length > 0).Select(w => w[0])).ToUpper())</span>
                <div class="grow"><p class="nm">@r.Name</p><p class="rl">@r.Department</p></div>
                <span class="tnum" style="text-align:right;line-height:1.3">In @(r.CheckInLabel ?? "—")<br>Out @(r.CheckOutLabel ?? "—")</span>
                <span class="tag" style="background:@bg;color:@fg">@label</span>
            </a>
        }
        @if (!Model.Roster.Any())
        {
            <p class="text-center text-muted py-4 mb-0">No active employees yet.</p>
        }
    </div>

    @if (Model.DailyBreakdown.Any())
    {
        <div class="card mt">
            <div class="sect">
                <div><h3>Attendance by day</h3><p>@(Model.Period == "month" ? "Last 30 days" : "Last 7 days")</p></div>
            </div>
            @foreach (var day in Model.DailyBreakdown)
            {
                var present = day.Roster.Count(r => r.Status != "Absent");
                <div class="pad" style="border-top:1px solid var(--line)">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
                        <b style="font-size:13.5px">@day.DateLabel</b>
                        <span style="font-size:11.5px;color:var(--mute)">@present of @day.Roster.Count present</span>
                    </div>
                    @if (!day.Roster.Any())
                    {
                        <p class="text-muted" style="font-size:12.5px;margin:0">No one scheduled.</p>
                    }
                    else
                    {
                        @foreach (var r in day.Roster)
                        {
                            var (bg, fg, label) = r.Status switch
                            {
                                "OnFloor" => ("var(--okSoft)", "var(--ok)", "On floor"),
                                "CheckedOut" => ("var(--accSoft)", "var(--accDeep)", "Checked out"),
                                "Late" => ("var(--warnSoft)", "var(--warn)", "Late"),
                                _ => ("var(--badSoft)", "var(--bad)", "Absent"),
                            };
                            <a class="list-row" style="text-decoration:none;color:inherit;cursor:pointer" asp-controller="Users" asp-action="Details" asp-route-id="@r.UserId">
                                <span class="av">@(string.Concat(r.Name.Split(' ').Where(w => w.Length > 0).Select(w => w[0])).ToUpper())</span>
                                <div class="grow"><p class="nm">@r.Name</p><p class="rl">@r.Department</p></div>
                                <span class="tnum" style="text-align:right;line-height:1.3">In @(r.CheckInLabel ?? "—")<br>Out @(r.CheckOutLabel ?? "—")</span>
                                <span class="tag" style="background:@bg;color:@fg">@label</span>
                            </a>
                        }
                    }
                </div>
            }
        </div>
    }
</div>

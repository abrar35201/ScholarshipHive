@model RouterFormViewModel
@{
    ViewData["Title"] = "Edit Router";
}

<div class="page-header">
    <div><h2>Edit Router</h2><p>Update router details.</p></div>
</div>

<div class="sh-card" style="max-width:520px;">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Router Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Bssid" class="form-label">BSSID (MAC Address)</label>
            <input asp-for="Bssid" class="form-control" />
            <span asp-validation-for="Bssid" class="text-danger small"></span>
        </div>
        <div class="form-check mb-4">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Active</label>
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

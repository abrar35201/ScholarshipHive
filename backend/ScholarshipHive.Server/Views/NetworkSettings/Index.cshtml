@model List<AllowedRouter>
@{
    ViewData["Title"] = "Network Settings";
    var pendingNetworks = (List<PendingNetwork>)ViewBag.PendingNetworks;
    var locations = (List<AllowedLocation>)ViewBag.Locations;
    var routerForm = (RouterFormViewModel)ViewBag.RouterFormModel;
}

<div class="page-header">
    <div>
        <h2>Network Settings</h2>
        <p>Only devices connected to an <strong>active</strong> router below can access the mobile app.</p>
    </div>
</div>

<div id="live-region">
    @if (pendingNetworks.Any())
    {
        <div class="card mb-3">
            <div class="sect"><div><h3>Pending Networks</h3><p>Captured automatically when a device tries to connect from an unrecognized router</p></div>
                <span class="tag" style="margin-left:auto;background:var(--warnSoft);color:var(--warn)">@pendingNetworks.Count</span></div>
            @foreach (var p in pendingNetworks)
            {
                <div class="list-row">
                    <span class="av"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 9c5.5-5 14.5-5 20 0"/><path d="M5.5 13c3.7-3.3 9.3-3.3 13 0"/><path d="M9 17c1.8-1.6 4.2-1.6 6 0"/></svg></span>
                    <div class="grow"><p class="nm">@(p.Ssid ?? "(unknown name)")</p><p class="rl mono">@p.Bssid</p></div>
                    <span class="tnum">@p.AttemptCount attempt@(p.AttemptCount == 1 ? "" : "s")</span>
                    <span class="rl" style="width:150px">@p.LastSeenAt.ToPakistanTime().ToString("MMM d, hh:mm tt")</span>
                    <form asp-action="ApprovePendingNetwork" asp-route-id="@p.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-primary" style="padding:6px 12px;font-size:12px">Approve</button>
                    </form>
                    <form asp-action="DismissPendingNetwork" asp-route-id="@p.Id" method="post" class="d-inline">
                        <button type="submit" class="btn danger" style="padding:6px 12px;font-size:12px">Dismiss</button>
                    </form>
                </div>
            }
        </div>
    }

    <div class="card mb-3" style="border-color:var(--accSoft);background:var(--accSoft)">
        <div class="pad" style="display:flex;gap:10px;align-items:flex-start">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accDeep)" stroke-width="2" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
            <p style="margin:0;font-size:13px;color:var(--accDeep)"><strong>Easiest way to approve a router:</strong> just wait for an employee's device to try connecting from it — it'll show up above under "Pending Networks" with its real MAC address already captured, ready to approve in one click.</p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="sect"><div><h3>Approved Routers</h3></div>
            <a href="#" role="button" data-bs-toggle="modal" data-bs-target="#addRouterModal" class="btn btn-primary" style="margin-left:auto;text-decoration:none">+ Add Router</a></div>
        @foreach (var r in Model)
        {
            <div class="list-row">
                <span class="av"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="9" width="18" height="7" rx="1.5"/><path d="M7 9V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v3M7 19v-3M12 19v-3M17 19v-3"/></svg></span>
                <div class="grow"><p class="nm">@r.Name</p><p class="rl mono">@r.Bssid</p></div>
                <span class="tag" style="background:@(r.IsActive ? "var(--okSoft)" : "var(--badSoft)");color:@(r.IsActive ? "var(--ok)" : "var(--bad)")">@(r.IsActive ? "Active" : "Inactive")</span>
                <span class="rl" style="width:100px">since @r.CreatedAt.ToString("yyyy-MM-dd")</span>
                <a asp-action="Edit" asp-route-id="@r.Id" class="btn ghost" style="padding:6px 12px;font-size:12px;text-decoration:none">Edit</a>
                <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this router?');">
                    <button type="submit" class="btn danger" style="padding:6px 12px;font-size:12px">Delete</button>
                </form>
            </div>
        }
        @if (!Model.Any())
        {
            <p class="text-center text-muted py-4 mb-0">No routers configured yet.</p>
        }
    </div>

    <div class="modal fade" id="addRouterModal" tabindex="-1" aria-labelledby="addRouterModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="Create" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addRouterModalLabel">Add Router</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div asp-validation-summary="All" class="text-danger mb-2"></div>
                        <div class="mb-3">
                            <label for="routerName" class="form-label">Router Name / SSID</label>
                            <input id="routerName" name="Name" value="@routerForm.Name" class="form-control" maxlength="100" required />
                        </div>
                        <div class="mb-3">
                            <label for="routerBssid" class="form-label">Router BSSID (MAC address)</label>
                            <input id="routerBssid" name="Bssid" value="@routerForm.Bssid" class="form-control" maxlength="17" pattern="([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}" placeholder="AA:BB:CC:DD:EE:FF" required />
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked="@(routerForm.IsActive ? "checked" : null)" id="routerIsActive" />
                            <input type="hidden" name="IsActive" value="false" />
                            <label class="form-check-label" for="routerIsActive">Active</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Add Router</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="sect"><div><h3>Office Locations (Geofence)</h3><p>Wakes the mobile app's attendance monitor on arrival/departure — doesn't replace the router check above</p></div>
            <a asp-action="CreateLocation" class="btn btn-primary" style="margin-left:auto;text-decoration:none">+ Add Location</a></div>
        @foreach (var l in locations)
        {
            <div class="list-row">
                <span class="av"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.3"/></svg></span>
                <div class="grow"><p class="nm">@l.Name</p><p class="rl mono">@l.Latitude.ToString("F5"), @l.Longitude.ToString("F5") · @l.RadiusMeters m radius</p></div>
                <span class="tag" style="background:@(l.IsActive ? "var(--okSoft)" : "var(--badSoft)");color:@(l.IsActive ? "var(--ok)" : "var(--bad)")">@(l.IsActive ? "Active" : "Inactive")</span>
                <a asp-action="EditLocation" asp-route-id="@l.Id" class="btn ghost" style="padding:6px 12px;font-size:12px;text-decoration:none">Edit</a>
                <form asp-action="DeleteLocation" asp-route-id="@l.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this location?');">
                    <button type="submit" class="btn danger" style="padding:6px 12px;font-size:12px">Delete</button>
                </form>
            </div>
        }
        @if (!locations.Any())
        {
            <p class="text-center text-muted py-4 mb-0">No office locations configured yet.</p>
        }
    </div>
</div>

@section Scripts {
    @if (ViewBag.ShowAddRouterModal == true)
    {
        <script>
            bootstrap.Modal.getOrCreateInstance(document.getElementById('addRouterModal')).show();
        </script>
    }
}

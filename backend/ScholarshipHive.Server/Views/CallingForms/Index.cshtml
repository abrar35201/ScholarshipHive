@using ScholarshipHive.Server.Services
@using ScholarshipHive.Server.Models
@model List<CallingFormEntry>
@{ViewData["Title"]="Calling Forms";var templates=(IReadOnlyList<CallingFormTemplate>)ViewBag.Templates;}
<div class="page-header"><div><h2>Calling Team — Country Forms</h2><p>Select the exact country/policy variant for your client.</p></div></div>
<div class="sh-card p-3 mb-3"><h5>Available forms</h5><div class="row g-3">
@foreach(var t in templates){<div class="col-md-6 col-lg-4"><div class="border rounded p-3 h-100"><b>@t.Name</b><div class="small text-muted">@t.Country</div><div class="d-flex gap-2 mt-3 flex-wrap"><a class="btn btn-primary btn-sm" href="/CallingForms/New/@t.Id">Fill draft</a><a target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm" href="/CallingForms/Template/@t.Id">Original PDF</a></div></div></div>}
</div></div>
<div class="sh-card p-3 table-responsive"><h5>My saved drafts</h5><table class="table table-hover"><thead><tr><th>Applicant</th><th>Form</th><th>Saved</th><th></th></tr></thead><tbody>
@foreach(var e in Model){<tr><td>@e.ApplicantName</td><td>@(CallingFormCatalog.Find(e.TemplateId)?.Name??e.TemplateId)</td><td>@e.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</td><td><a class="btn btn-sm btn-outline-primary" href="/CallingForms/Details/@e.Id">View</a></td></tr>}
</tbody></table></div>
<p class="text-muted small">Draft data entry only. Read the original agreement and obtain required signatures independently. Saved drafts do not constitute signed consent.</p>
